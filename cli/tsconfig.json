{
    "compilerOptions": {
        "target": "ES2023",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        // Node 24 only: no DOM types, so browser globals fail to compile.
        "lib": ["ES2023"],
        "types": ["node"],
        "resolveJsonModule": true,
        // Tests import build-defaults.mjs; it is read for its types but not checked.
        "allowJs": true,
        "checkJs": false,
        "isolatedModules": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "noEmit": true,
        "baseUrl": ".",
        "paths": {
            "@core/*": ["../shared/core/*"]
        },

        /* Linting */
        "strict": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "noFallthroughCasesInSwitch": true,
        "noUncheckedSideEffectImports": true
    },
    "include": ["src/**/*.ts", "tests/**/*.ts", "vitest.config.ts"]
}
