{
    "name": "saltnet",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "check": "vue-tsc -b && tsc -p shared/core/tsconfig.json && tsc -p cli/tsconfig.json && prettier --check .",
        "build": "vue-tsc -b && vite build && node ./script/generateBuildInfo.cjs",
        "build:cli": "pnpm --filter saltnet-cli build",
        "preview": "vite preview",
        "pret": "prettier --check .",
        "pret:fix": "prettier --write .",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "test:course": "vitest run shared/core/course/index.test.ts",
        "test:kaleidxscope": "vitest run shared/core/kaleidxscope/index.test.ts",
        "test:collection-index": "vitest run src/components/data/collection/index.test.ts src/components/data/collection/relatedCollections.test.ts shared/core/collection/versionPlate.test.ts shared/core/collection/map.test.ts shared/core/collection/static.test.ts shared/core/collection/related.test.ts shared/core/integrations/lxns/fetchCollection.test.ts",
        "test:score-history": "vitest run src/components/data/user/update/migrateData.test.ts src/components/data/user/scoreHistory/index.test.ts src/components/data/user/scoreHistory/queue.test.ts",
        "test:recent": "vitest run shared/core/chart/recent.test.ts",
        "test:build-info": "node --test script/generateBuildInfo.test.cjs",
        "test:cli": "pnpm --filter saltnet-cli test",
        "test:music-search": "vitest run shared/core/music/search.test.ts",
        "test:music-data": "vitest run shared/core/music/fetch.test.ts shared/core/music/cache.test.ts shared/core/fixtures/saltmeta.test.ts",
        "test:query": "vitest run shared/core/query/songs.test.ts",
        "test:oauth": "vitest run src/components/integrations/lxns/oauthSession.test.ts src/components/integrations/lxns/oauth.test.ts src/components/integrations/lxns/token.test.ts src/components/app/shared.test.ts src/stores/dialog.test.ts"
    },
    "dependencies": {
        "jwt-decode": "^4.0.0",
        "localforage": "^1.10.0",
        "mdui": "^2.1.3",
        "opencc-js": "1.4.2",
        "pinia": "^3.0.3",
        "pinyin-pro": "3.29.4",
        "react": "^19.2.7",
        "takumi-js": "rc",
        "vue": "^3.5.13",
        "vue-router": "^4.5.0",
        "wanakana": "5.3.1"
    },
    "devDependencies": {
        "@antfu/eslint-config": "^6.7.3",
        "@types/node": "^22.14.1",
        "@types/react": "^19.2.17",
        "@vitejs/plugin-legacy": "^7.2.1",
        "@vitejs/plugin-vue": "^6.0.1",
        "@vue/tsconfig": "^0.7.0",
        "eslint": "^9.39.2",
        "eslint-plugin-format": "^2.0.1",
        "fake-indexeddb": "^6.2.5",
        "path": "^0.12.7",
        "prettier": "^3.5.3",
        "typescript": "~5.7.2",
        "url": "^0.11.4",
        "vite": "^7.1.1",
        "vitest": "^3.2.4",
        "vue-tsc": "^2.2.8"
    }
}
